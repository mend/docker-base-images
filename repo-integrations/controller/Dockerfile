    >> "$JAVA_HOME/lib/security/blocked.certs" \
    && grep -qxi "42C4ACCD12C4F59597925E1A08A7A90102608543809308D50EC427E118BA1493" "$JAVA_HOME/lib/security/blocked.certs"

